# Copy to .env and adjust. Never commit .env.

# Linux only: run `id -u` and put the value here so Airflow bind mounts are not root-owned
AIRFLOW_UID=50000

# s1 · external Data API (reached through the host VPN)
DATA_API_URL=https://data-api.example.internal
DATA_API_TOKEN=

# s3 · PostgreSQL (business database, published on the host)
POSTGRES_PORT=5432
DATA_DB_NAME=cubierta_forestal
DATA_DB_USER=app
DATA_DB_PASSWORD=app

# Airflow metadata database (separate instance and volume, internal only)
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow

# s2 · Airflow
AIRFLOW_VERSION=3.3.2
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_JWT_SECRET=change-me-jwt-secret
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# s5 · MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MODELS_BUCKET=models

# s4 · Jupyter
JUPYTER_PORT=8888
JUPYTER_TOKEN=cubierta

# s6 · Inference API
INFERENCE_API_PORT=8000
MODEL_NAME=cubierta-forestal
